// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  username        String          @unique
  email           String          @unique
  password        String
  score           Int             @default(0)
  currentLevel    Int             @default(1) // 1 to 5 (or 6 if finished all levels)
  currentQuestion Int             @default(1) // 1 to 6
  startTime       DateTime        @default(now())
  elapsedTime     Int             @default(0) // total time in seconds
  completedAt     DateTime?
  sessionToken    String?         // Added for single session enforcement
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  progress        LevelProgress[]

  @@index([score, elapsedTime])
}

model LevelProgress {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       Int       // 1 to 5
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, level])
}

model OtpRecord {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  otp       String
  sentCount Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

